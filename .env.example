# Inquiry forms notification email (Resend) — https://resend.com
# API key from your Resend dashboard.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (e.g. ollin.live).
CONTACT_FROM_EMAIL="Ollin <no-reply@ollin.live>"

# Where inquiry form submissions are delivered. Defaults to hello@ollin.bio if unset.
CONTACT_TO_EMAIL=hello@ollin.bio

# Supabase (persists all 6 inquiry form submissions; no auth used)
# Public by design: NEXT_PUBLIC_ vars are exposed to the browser, and the
# publishable key only allows what RLS policies grant to the anon role
# (insert-only on inquiries, no reads).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
